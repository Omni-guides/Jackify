*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db 

# Development-only directories (should not be in public repo)
docs/
testing/

# Build files (development only)
*.spec
hook-*.py
requirements-packaging.txt

# Development logs
logs/

# Build artifacts (from pyproject.toml / pip install -e .)
*.egg-info/

