# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
.env/

# Logs
*.log
jackify-install-engine/logs/ 
logs/

# Build artifacts
build/
dist/
core/__pycache__/
core/modules/__pycache__/

